# === VELORA ENVIRONMENT VARIABLES ===

# --- Authentication (Clerk) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- AI Provider ---
# Primary AI for transcription, analysis, and editing decisions.
# Provider: "nvidia" | "gemini"
AI_PROVIDER=nvidia

# NVIDIA NIM API Key (required if AI_PROVIDER=nvidia)
NVIDIA_API_KEY=

# Gemini API Key (required if AI_PROVIDER=gemini)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- AI Video Editing Pipeline ---
# Enable AI-powered editing on generated clips (runs automatically after clipping)
AI_EDITING_ENABLED=true

# Credits deducted per AI-edited clip
AI_EDITING_CREDIT_COST=15

# Whisper model size for transcription: tiny | base | small | medium
# base = fast, good accuracy. small = better accuracy, ~2x slower. tiny = fastest, lower accuracy.
WHISPER_MODEL=base

# --- Viral Scoring ---
# Minimum viral score (0-100) for a clip to be exported. Lower = more clips, higher = stricter.
VIRAL_MIN_SCORE=60
# Minimum hook strength score (0-10) required. Clips with weak hooks are rejected.
VIRAL_MIN_DIMENSION=4
# Maximum number of moments the AI will return
VIRAL_MAX_MOMENTS=15

# --- Video Processing ---
# FFmpeg path (auto-detected from ffmpeg-static if not set)
# FFMPEG_PATH=

# YouTube cookies (REQUIRED for YouTube downloads)
# Export cookies from your browser using a browser extension (e.g. "Get cookies.txt LOCALLY")
# Place the file at server/cookies.txt
# Without this, YouTube WILL block downloads with 403 errors
# YTDLP_PROXY=

# --- Redis (optional, for BullMQ job queue) ---
# REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=5000
NODE_ENV=development
